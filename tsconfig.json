{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "skipLibCheck": false,
        "paths": {
            "nexa-transport": ["./src/networking/NexaClient.ts"],
            "nexa-transport/protocol": ["./src/protocol/Protocol.ts"],
            "nexa-transport/media": ["./src/media/NexaMedia.ts"],
            "nexa-transport/events": ["./src/protocol/Events.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts", "examples/**/*.ts"]
}
