            "types": "./dist/workflows/WorkflowTypes.d.ts",
            "import": "./dist/workflow-types.js"
        },
        "./workflow-codec": {
            "types": "./dist/workflows/WorkflowCodec.d.ts",
            "import": "./dist/workflow-codec.js"
        },
        "./workflow-resources": {
            "types": "./dist/workflows/ResourceTypes.d.ts",
            "import": "./dist/workflow-resources.js"
        },
        "./workflow-resource-codec": {
            "types": "./dist/workflows/ResourceBindingCodec.d.ts",
            "import": "./dist/workflow-resource-codec.js"
        },
        "./workflow-resource-readiness": {
            "types": "./dist/workflows/ResourceReadiness.d.ts",
            "import": "./dist/workflow-resource-readiness.js"
        },
        "./company-hosts": {
            "types": "./dist/company/CompanyHostTypes.d.ts",
            "import": "./dist/company-hosts.js"
        },
        "./employee-results": {
            "types": "./dist/company/CompanyEmployeeTypes.d.ts",
            "import": "./dist/employee-results.js"
        },
        ".": {
            "types": "./dist/networking/NexaClient.d.ts",
            "import": "./dist/nexa-transport.js"
        },
        "./protocol": {
            "types": "./dist/protocol/Protocol.d.ts",
            "import": "./dist/protocol.js"
        },
        "./media": {
            "types": "./dist/media/NexaMedia.d.ts",
            "import": "./dist/media.js"
        },
        "./events": {
            "types": "./dist/protocol/Events.d.ts",
            "import": "./dist/events.js"
        },
        "./errors": {
            "types": "./dist/networking/TransportError.d.ts",
            "import": "./dist/errors.js"
        },
        "./options": {
            "types": "./dist/interface/ClientOptions.d.ts"
        },
        "./stream": {
            "types": "./dist/networking/TurnStream.d.ts"
        },
        "./stream-options": {
            "types": "./dist/interface/StreamOptions.d.ts"
        },
        "./office": {
            "types": "./dist/office/OfficeProtocol.d.ts",
            "import": "./dist/office.js"
        },
        "./company": {
            "types": "./dist/company/CompanyProtocol.d.ts",
            "import": "./dist/company.js"
        },
        "./company-types": {
            "types": "./dist/company/CompanyTypes.d.ts",
            "import": "./dist/company-types.js"
        },
        "./projects": {
            "types": "./dist/company/CompanyProjectProtocol.d.ts",
            "import": "./dist/projects.js"
        },
        "./project-types": {
            "types": "./dist/company/CompanyProjectTypes.d.ts",
            "import": "./dist/project-types.js"
        },
        "./work-types": {
            "types": "./dist/company/CompanyWorkTypes.d.ts"
        },
        "./company-limits": {
            "types": "./dist/company/CompanyLimitsTypes.d.ts"
        },
        "./workflow-requests": {
            "types": "./dist/workflows/WorkflowRequests.d.ts",
            "import": "./dist/workflow-requests.js"
        },
        "./workflow-request-codec": {
            "types": "./dist/workflows/WorkflowRequestCodec.d.ts",
            "import": "./dist/workflow-request-codec.js"
        },
        "./workflow-catalog": {
            "types": "./dist/workflows/ComponentRegistry.d.ts",
            "import": "./dist/workflow-catalog.js"
        },
        "./workflow-component-types": {
            "types": "./dist/workflows/ComponentTypes.d.ts",
            "import": "./dist/workflow-component-types.js"
        },
        "./workflow-validation": {
            "types": "./dist/workflows/GraphValidation.d.ts",
            "import": "./dist/workflow-validation.js"
        },
        "./workflow-graph-types": {
            "types": "./dist/workflows/GraphTypes.d.ts",
            "import": "./dist/workflow-graph-types.js"
        },
        "./workflow-ports": {
            "types": "./dist/workflows/PortCompatibility.d.ts",
            "import": "./dist/workflow-ports.js"
        },
        "./workflow-schemas": {
            "types": "./dist/workflows/Schemas.d.ts",
            "import": "./dist/workflow-schemas.js"
        },
        "./workflow-schema-types": {
            "types": "./dist/workflows/SchemaTypes.d.ts",
            "import": "./dist/workflow-schema-types.js"
        },
        "./workflow-values": {
            "types": "./dist/workflows/SchemaValues.d.ts",
            "import": "./dist/workflow-values.js"
        },
        "./workflow-run-types": {
            "types": "./dist/workflows/runtime/RunTypes.d.ts",
            "import": "./dist/workflow-run-types.js"
        },
        "./workflow-run-requests": {
            "types": "./dist/workflows/runtime/RunRequests.d.ts",
            "import": "./dist/workflow-run-requests.js"
        },
        "./workflow-run-codec": {
            "types": "./dist/workflows/runtime/RunCodec.d.ts",
            "import": "./dist/workflow-run-codec.js"
        },
        "./workflow-run-request-codec": {
            "types": "./dist/workflows/runtime/RunRequestCodec.d.ts",
            "import": "./dist/workflow-run-request-codec.js"
        },
        "./workflow-planning-sources": {
            "types": "./dist/workflows/planning/PlanningSources.d.ts",
            "import": "./dist/workflow-planning-sources.js"
        },
        "./workflow-planning-alignment": {
            "types": "./dist/workflows/planning/PlanningAlignment.d.ts",
            "import": "./dist/workflow-planning-alignment.js"
        },
        "./workflow-model-policy": {
            "types": "./dist/workflows/ModelResolution.d.ts",
            "import": "./dist/workflow-model-policy.js"
        },
        "./workflow-models": {
            "types": "./dist/workflows/WorkflowModels.d.ts",
            "import": "./dist/workflow-models.js"
        },
        "./workflow-artifacts": {
            "types": "./dist/workflows/runtime/ArtifactDownload.d.ts",
