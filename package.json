{
    "name": "nexa-transport",
    "version": "0.1.0",
    "description": "Typed Nexa websocket gateway client for browsers and Node.js",
    "type": "module",
    "license": "Apache-2.0",
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "NOTICE",
        "server-patches",
        "docs"
    ],
    "exports": {
        ".": {
            "types": "./dist/networking/NexaClient.d.ts",
            "import": "./dist/nexa-transport.js"
        },
        "./protocol": {
            "types": "./dist/protocol/Protocol.d.ts",
            "import": "./dist/protocol.js"
        },
        "./media": {
            "types": "./dist/media/NexaMedia.d.ts",
            "import": "./dist/media.js"
        },
        "./events": {
            "types": "./dist/protocol/Events.d.ts",
            "import": "./dist/events.js"
        },
        "./errors": {
            "types": "./dist/networking/TransportError.d.ts",
            "import": "./dist/errors.js"
        },
        "./options": {
            "types": "./dist/interface/ClientOptions.d.ts"
        },
        "./stream": {
            "types": "./dist/networking/TurnStream.d.ts"
        },
        "./stream-options": {
            "types": "./dist/interface/StreamOptions.d.ts"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --type-aware --type-check --deny-warnings src test examples",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
        "prepack": "npm run check",
        "generate": "node script/generate.mjs",
        "test:gateway": "cd ../nexa && npx vitest run test/gateway/TransportAttachments.test.ts test/gateway/TransportBrowser.test.ts test/gateway/TransportRich.test.ts",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"examples/**/*.ts\" \"script/*.{mjs,ts,json}\" \"*.{ts,json,md}\" \"docs/**/*.md\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"examples/**/*.ts\" \"script/*.{mjs,ts,json}\" \"*.{ts,json,md}\" \"docs/**/*.md\"",
        "test:package": "node script/pack-smoke.mjs",
        "docs": "node script/document.mjs && prettier --write \"docs/**/*.md\""
    },
    "devDependencies": {
        "@types/node": "^26.5.1",
        "@types/ws": "^8.18.1",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2002",
        "typescript": "~7.0.2",
        "typescript-json-schema": "^0.68.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.0",
        "ws": "^8.21.3",
        "prettier": "^3.9.6"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "nexa",
        "nervalab",
        "websocket",
        "ai",
        "agent",
        "typescript",
        "sdk",
        "transport"
    ]
}
