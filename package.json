{
    "name": "nexa-transport",
    "version": "0.1.0-host-tools.4",
    "description": "Typed Nexa websocket gateway client for browsers and Node.js",
    "type": "module",
    "license": "UNLICENSED",
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "NOTICE",
        "docs"
    ],
    "exports": {
        "./redteam-client": {
            "types": "./dist/redteam/RedTeamClient.d.ts",
            "import": "./dist/redteam-client.js"
        },
        "./archive-requests": {
            "types": "./dist/networking/SessionArchiveRequests.d.ts",
            "import": "./dist/archive-requests.js"
        },
        ".": {
            "types": "./dist/networking/NexaClient.d.ts",
            "import": "./dist/nexa-transport.js"
        },
        "./media": {
            "types": "./dist/media/Media.d.ts",
            "import": "./dist/media.js"
        },
        "./events": {
            "types": "./dist/protocol/Events.d.ts",
            "import": "./dist/events.js"
        },
        "./errors": {
            "types": "./dist/networking/TransportError.d.ts",
            "import": "./dist/errors.js"
        },
        "./options": {
            "types": "./dist/interface/ClientOptions.d.ts"
        },
        "./stream": {
            "types": "./dist/networking/TurnStream.d.ts"
        },
        "./stream-options": {
            "types": "./dist/interface/StreamOptions.d.ts"
        },
        "./session-files": {
            "types": "./dist/networking/SessionFilePager.d.ts",
            "import": "./dist/session-files.js"
        },
        "./history-records": {
            "types": "./dist/networking/HistoryRecordDecoder.d.ts",
            "import": "./dist/history-records.js"
        }
    },
    "scripts": {
        "build": "npm run check:circular && vite build && tsc -p tsconfig.build.json",
        "prepare": "npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --type-aware --type-check --deny-warnings src test examples",
        "test": "vitest run",
        "test:memory": "npm run build && node --expose-gc --test script/memory-gc.mjs",
        "test:memory:browser": "npm run build && node script/memory-browser.mjs",
        "check": "npm run typecheck && npm run docs:check && npm run lint && npm run format:check && npm test && npm run test:memory",
        "prepack": "npm run check",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"examples/**/*.ts\" \"script/*.{mjs,ts,json}\" \"*.{ts,json,md}\" \"docs/**/*.md\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"examples/**/*.ts\" \"script/*.{mjs,ts,json}\" \"*.{ts,json,md}\" \"docs/**/*.md\"",
        "test:package": "node script/pack-smoke.mjs",
        "docs:check": "node script/check-docs.mjs",
        "check:circular": "madge --circular --strict src test examples"
    },
    "devDependencies": {
        "@types/node": "^26.5.1",
        "@types/ws": "^8.18.1",
        "madge": "https://codeload.github.com/dacely-cloud/madge/tar.gz/065cb322d7fae520c5343d492f277c9f89f60938",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2002",
        "prettier": "^3.9.6",
        "typescript": "~7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.0",
        "ws": "^8.21.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "nexa",
        "nervalab",
        "websocket",
        "ai",
        "agent",
        "typescript",
        "sdk",
        "transport"
    ],
    "dependencies": {
        "meshoptimizer": "^1.2.0",
        "nerva-connector-protocol": "https://codeload.github.com/dacely-cloud/nerva-connector-protocol/tar.gz/c4a7fa7a47f0800975195cbdfa38f014c524f5c5",
        "nexa-protocol": "https://codeload.github.com/dacely-cloud/nexa-protocol/tar.gz/f1561b1ff2fe6bfb7d3b63b8a3d6a24f357fd78b"
    },
    "madge": {
        "baseDir": ".",
        "fileExtensions": [
            "ts",
            "tsx",
            "mts",
            "cts",
            "js",
            "jsx",
            "mjs",
            "cjs"
        ],
        "respectGitIgnore": true,
        "tsConfig": "./tsconfig.json"
    }
}
