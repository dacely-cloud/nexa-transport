        "prettier": "^3.9.6",
        "typescript": "~7.0.2",
        "typescript-json-schema": "^0.68.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.0",
        "ws": "^8.21.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
