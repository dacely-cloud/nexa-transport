{
    "name": "nexa-transport",
    "version": "0.1.0",
    "description": "Typed Nexa websocket gateway client for browsers and Node.js",
    "type": "module",
    "license": "Apache-2.0",
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "NOTICE",
        "docs"
    ],
    "exports": {
        "./reverse-investigation": {
            "types": "./dist/reverse/ReverseInvestigation.d.ts",
            "import": "./dist/reverse-investigation.js"
        },
        "./workflow-image-quote": {
            "types": "./dist/workflows/WorkflowImageQuote.d.ts",
            "import": "./dist/workflow-image-quote.js"
        },
        "./workflow-planning-types": {
