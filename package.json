            "types": "./dist/workflows/planning/PlanningCodec.d.ts",
            "import": "./dist/workflow-planning-codec.js"
        },
        "./workflow-planning-edits": {
            "types": "./dist/workflows/planning/PlanningEdits.d.ts",
            "import": "./dist/workflow-planning-edits.js"
        },
