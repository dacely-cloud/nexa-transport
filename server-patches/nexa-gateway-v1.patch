diff --git a/src/gateway/Attachments.ts b/src/gateway/Attachments.ts
new file mode 100644
index 00000000..264dfb13
--- /dev/null
+++ b/src/gateway/Attachments.ts
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: Apache-2.0
+
+import { ErrorCode, NexaError } from '../core/Errors';
+import type { BinarySource, ContentBlock } from '../providers/Types';
+
+/** User-authored attachment kinds accepted by the agent's public boundary. */
+export const AttachmentType = {
+    Text: 'text',
+    Image: 'image',
+    Video: 'video',
+    VideoFrame: 'video-frame',
+    Document: 'document',
+} as const;
+
+/** A user attachment cannot inject tool results or provider reasoning into history. */
+export type InboundAttachment = Extract<
+    ContentBlock,
+    { readonly type: (typeof AttachmentType)[keyof typeof AttachmentType] }
+>;
+
+/** Validates bounded attachment lists without altering binary bytes or ordering. */
+export function parseAttachments(raw: unknown): readonly InboundAttachment[] {
+    if (!Array.isArray(raw) || raw.length > 64) {
+        throw invalidAttachment('attachments must be an array of at most 64 blocks');
+    }
+    return raw.map((block: unknown): InboundAttachment => {
+        if (typeof block !== 'object' || block === null || !('type' in block)) {
+            throw invalidAttachment('attachment must have a type');
+        }
+        if (
+            block.type === AttachmentType.Text &&
+            'text' in block &&
+            typeof block.text === 'string'
+        ) {
+            return { type: AttachmentType.Text, text: block.text };
+        }
+        if (
+            block.type !== AttachmentType.Image &&
+            block.type !== AttachmentType.Video &&
+            block.type !== AttachmentType.VideoFrame &&
+            block.type !== AttachmentType.Document
+        ) {
+            throw invalidAttachment('unsupported inbound attachment type');
+        }
+        if (!('source' in block)) {
+            throw invalidAttachment('binary attachment must have a source');
+        }
+        const source: BinarySource = parseSource(block.source);
+        if ('title' in block && typeof block.title !== 'string') {
+            throw invalidAttachment('attachment title must be a string');
+        }
+        return {
+            type: block.type,
+            source,
+            ...('title' in block && typeof block.title === 'string' ? { title: block.title } : {}),
+        };
+    });
+}
+
+/** Validates the provider-neutral binary source at the websocket trust boundary. */
+function parseSource(raw: unknown): BinarySource {
+    if (typeof raw !== 'object' || raw === null || !('kind' in raw)) {
+        throw invalidAttachment('attachment source must have a kind');
+    }
+    if (raw.kind === 'url' && 'url' in raw && typeof raw.url === 'string') {
+        let url: URL;
+        try {
+            url = new URL(raw.url);
+        } catch {
+            throw invalidAttachment('attachment URL must be absolute HTTP or HTTPS');
+        }
+        if (
+            (url.protocol !== 'https:' && url.protocol !== 'http:') ||
+            url.username ||
+            url.password
+        ) {
+            throw invalidAttachment('attachment URL must be HTTP or HTTPS without credentials');
+        }
+        return { kind: 'url', url: raw.url };
+    }
+    if (
+        raw.kind === 'base64' &&
+        'mediaType' in raw &&
+        typeof raw.mediaType === 'string' &&
+        raw.mediaType.length > 0 &&
+        'data' in raw &&
+        typeof raw.data === 'string' &&
+        raw.data.length > 0 &&
+        raw.data.length % 4 === 0 &&
+        /^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(raw.data)
+    ) {
+        return { kind: 'base64', mediaType: raw.mediaType, data: raw.data };
+    }
+    throw invalidAttachment('attachment source must contain a URL or valid base64 and mediaType');
+}
+
+/** Returns the gateway's standard invalid-request error. */
+function invalidAttachment(message: string): NexaError {
+    return new NexaError(ErrorCode.InvalidRequest, message, { source: 'gateway' });
+}
